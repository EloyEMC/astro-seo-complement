---
import DemoLayout from '../layouts/DemoLayout.astro';
import { buildFAQPage, composeGraph } from '../schemas';
const questions = [
  { question: 'Does SEO.astro create the JSON-LD script?', answer: 'Yes. Pass a schema node or composed graph to SEO.astro and it serializes the graph safely for the document head.' },
  { question: 'Can I use the component without content collections?', answer: 'Yes. The explicit metadata props work for any Astro page; content collections are optional.' },
  { question: 'Where can I inspect the generated graph?', answer: 'Open the JSON-LD inspection panel on each demo page or view the generated page source.' },
  { question: 'Does structured data guarantee search visibility?', answer: 'No. It describes a page for eligible consumers, but search engines decide indexing, rankings, and rich-result display using many signals.' },
];
const schema = composeGraph(buildFAQPage(questions));
---
<DemoLayout title="Frequently asked questions" description="An FAQPage example where each visible answer matches its structured Question and Answer pair." canonicalUrl="/faq/" schema={schema} eyebrow="FAQ schema">
  <section class="panel"><p>Start with the questions people actually ask about integrating the package. Each answer below is rendered from the same data passed to the <code>FAQPage</code> builder.</p></section>
  <section class="grid" aria-label="Frequently asked questions">
    {questions.map(({ question, answer }) => <article class="card"><h2>{question}</h2><p>{answer}</p></article>)}
  </section>
  <p class="panel" style="margin-top: 1rem">The graph is useful because it is honest about the page: it repeats the complete visible answers instead of adding hidden promotional copy.</p>
</DemoLayout>
