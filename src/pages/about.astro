---
import DemoLayout from '../layouts/DemoLayout.astro';
import { siteConfig } from '../config';
import { buildBreadcrumbList, buildOrganization, buildWebPage, composeGraph } from '../schemas';
const schema = composeGraph(
  buildOrganization({ name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site, sameAs: ['https://github.com/Gentleman-Programming/astro-seo-complement'] }),
  buildWebPage({ url: '/about/', siteUrl: siteConfig.site, name: 'About astro-seo-complement', description: 'Learn how this demo maps content to SEO metadata and schema.' }),
  buildBreadcrumbList([{ name: 'Home', item: '/' }, { name: 'About', item: '/about/' }], siteConfig.site),
);
---
<DemoLayout title="About the demo" description="A generic WebPage that introduces the project and its Organization identity." canonicalUrl="/about/" schema={schema}>
  <section class="panel"><h2>Purpose</h2><p><strong>astro-seo-complement</strong> provides an Astro <code>SEO.astro</code> component plus composable schema builders. This page demonstrates explicit WebPage metadata, an Organization node, and a breadcrumb trail.</p></section>
  <h2>Identity signals</h2><div class="grid"><article class="card"><h3>One canonical site</h3><p>Every route resolves against <code>{siteConfig.site}</code>, so canonical links and schema URLs stay consistent.</p></article><article class="card"><h3>Composable graphs</h3><p>Related nodes are combined with <code>composeGraph</code> instead of emitting several competing JSON-LD scripts.</p></article></div>
</DemoLayout>
