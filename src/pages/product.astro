---
import DemoLayout from '../layouts/DemoLayout.astro';
import { siteConfig } from '../config';
import { buildAggregateOffer, buildBreadcrumbList, buildImageObject, buildOffer, buildProduct, composeGraph } from '../schemas';
const seller = { name: 'astro-seo-complement maintainers', url: siteConfig.site };
const offers = [{ id: '/product/#offer-starter', price: 9, priceCurrency: 'USD', url: '/product/', availability: 'https://schema.org/InStock', seller }, { id: '/product/#offer-pro', price: 19, priceCurrency: 'USD', url: '/product/', availability: 'https://schema.org/InStock', seller }];
const productImage = buildImageObject({ name: 'SEO Field Guide cover', contentUrl: '/field-guide.svg', caption: 'Illustrative cover for the fictional SEO Field Guide', width: 1200, height: 800, siteUrl: siteConfig.site });
    const schema = composeGraph(buildProduct({ name: 'SEO Field Guide', description: 'A practical digital field guide for building inspectable Astro pages.', url: '/product/', siteUrl: siteConfig.site, sku: 'FIELD-GUIDE-001', brand: 'astro-seo-complement', image: '/field-guide.svg', offers }), productImage, buildOffer({ ...offers[0], siteUrl: siteConfig.site }), buildAggregateOffer({ lowPrice: 9, highPrice: 19, offerCount: 2, priceCurrency: 'USD', siteUrl: siteConfig.site, offers }), buildBreadcrumbList([{ name: 'Home', item: '/' }, { name: 'Product', item: '/product/' }], siteConfig.site));
---
<DemoLayout title="SEO Field Guide" description="A clearly labeled demo Product page showing one Offer and an AggregateOffer with synchronized pricing data." canonicalUrl="/product/" schema={schema} eyebrow="Product schema · illustrative demo data">
  <section class="panel">
    <p><span class="tag">Illustrative demo product · SKU FIELD-GUIDE-001</span></p>
    <h2>A compact guide to inspectable Astro pages</h2>
    <p>The SEO Field Guide is fictional sample data used to demonstrate a Product graph. It is not a real product, checkout, or commercial offer.</p>
    <figure><img src="/field-guide.svg" alt="Illustrative cover for the fictional SEO Field Guide" width="1200" height="800" loading="eager" /><figcaption>Illustrative demo cover · 1200 × 800 SVG. The same URL is used by Product and ImageObject JSON-LD.</figcaption></figure>
    <p><strong>Example editions: $9.00 USD and $19.00 USD · Example availability: In stock</strong></p>
  </section>
  <section aria-labelledby="offer-title">
    <h2 id="offer-title">How the offer data maps</h2>
    <div class="grid">
      <article class="card"><h3>Starter edition · $9.00 USD</h3><p>The first <code>Offer</code> supplies the price, currency, seller, product URL, and illustrative availability shown above.</p></article>
      <article class="card"><h3>Two-edition range · $9–$19 USD</h3><p>The <code>AggregateOffer</code> summarizes two example editions. Both values remain visible so the graph does not hide the facts it describes.</p></article>
    </div>
  </section>
</DemoLayout>
