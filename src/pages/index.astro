---
import DemoLayout from '../layouts/DemoLayout.astro';
import { siteConfig } from '../config';
import { buildOrganization, buildPerson, buildProfilePage, buildWebSite, composeGraph } from '../schemas';

const organization = buildOrganization({ name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site });
const schema = composeGraph(
  buildWebSite({ name: siteConfig.title, url: siteConfig.site, siteUrl: siteConfig.site, description: siteConfig.description, publisher: { name: 'astro-seo-complement maintainers', url: siteConfig.site } }),
  organization,
  buildProfilePage({ url: '/', siteUrl: siteConfig.site, name: siteConfig.title, mainEntity: { name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site, type: 'Person' } }),
  buildPerson({ name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site, jobTitle: 'Open-source maintainers' }),
);
const examples = [
  ['/about/', 'About and site identity', 'Project facts, maintainer links, and WebPage relationships'],
  ['/blog/', 'Blog notes', 'Three real content entries with BlogPosting metadata'],
  ['/editorial/', 'Editorial article', 'A complete NewsArticle with publisher and dates'],
  ['/product/', 'Product offers', 'Clearly labeled illustrative Product data'],
  ['/reviews/', 'Reviews', 'Clearly labeled illustrative Review data'],
  ['/faq/', 'Frequently asked questions', 'FAQPage with visible, complete answers'],
  ['/how-to/', 'How-to guide', 'A four-step HowTo with a twenty-minute estimate'],
  ['/breadcrumbs/', 'Breadcrumbs', 'Visible navigation mirrored in structured data'],
];
---
<DemoLayout title={siteConfig.title} description={siteConfig.description} canonicalUrl="/" schema={schema} eyebrow="A living showcase for Astro" uppercaseTitle>
  <section class="panel">
    <p><span class="tag">No extra dependencies</span></p>
    <p>This site is a small, reusable editorial template built around <code>astro-seo-complement</code>. Each route pairs useful semantic HTML with explicit metadata and a schema graph you can inspect in the page source.</p>
    <p>Use the examples as a reading path: start with the <a href="/about/">project context</a>, browse the <a href="/blog/">editorial notes</a>, then compare the page types when you need a Product, FAQ, HowTo, or BreadcrumbList pattern.</p>
  </section>
  <h2>Explore the supported use cases</h2>
  <div class="grid">
    {examples.map(([href, name, detail]) => <article class="card"><h3><a href={href}>{name}</a></h3><p>{detail}</p></article>)}
  </div>
  <h2>What to inspect</h2>
  <div class="grid">
    <article class="card"><h3>Metadata</h3><p>Canonical URLs, descriptions, Open Graph, Twitter cards, robots directives, authors, and dates are generated from explicit page facts.</p></article>
    <article class="card"><h3>JSON-LD</h3><p>Open each route's inspection panel, then compare the graph with the page source. Visible copy is intentionally aligned with the machine-readable data.</p></article>
    <article class="card"><h3>Source and contact</h3><p>Learn about the project on the <a href="/about/">About page</a>, visit the <a href="https://github.com/EloyEMC/astro-seo-complement">GitHub source</a>, or follow the maintainer link there.</p></article>
  </div>
</DemoLayout>
