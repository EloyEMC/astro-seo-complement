---
import DemoLayout from '../layouts/DemoLayout.astro';
import { siteConfig } from '../config';
import { buildOrganization, buildPerson, buildProfilePage, buildWebSite, composeGraph } from '../schemas';

const organization = buildOrganization({ name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site });
const schema = composeGraph(
  buildWebSite({ name: siteConfig.title, url: siteConfig.site, siteUrl: siteConfig.site, description: siteConfig.description, publisher: { name: 'astro-seo-complement maintainers', url: siteConfig.site } }),
  organization,
  buildProfilePage({ url: '/', siteUrl: siteConfig.site, name: 'astro-seo-complement Demo', mainEntity: { name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site, type: 'Person' } }),
  buildPerson({ name: 'astro-seo-complement maintainers', url: siteConfig.site, siteUrl: siteConfig.site, jobTitle: 'Open-source maintainers' }),
);
const examples = [
  ['/about/', 'About and site identity', 'WebPage, Organization, and BreadcrumbList'],
  ['/blog/hello-world/', 'Blog posting', 'Content frontmatter to BlogPosting'],
  ['/editorial/', 'Editorial article', 'NewsArticle with publisher and dates'],
  ['/product/', 'Product offers', 'Product, Offer, and AggregateOffer'],
  ['/reviews/', 'Reviews', 'Review and AggregateRating'],
  ['/faq/', 'Frequently asked questions', 'FAQPage with visible answers'],
  ['/how-to/', 'How-to guide', 'HowTo steps and duration'],
  ['/breadcrumbs/', 'Breadcrumbs', 'Navigation hierarchy as structured data'],
];
---
<DemoLayout title={siteConfig.title} description={siteConfig.description} canonicalUrl="/" schema={schema} eyebrow="A living showcase for Astro">
  <section class="panel">
    <p><span class="tag">No extra dependencies</span></p>
    <p>This site is the small, inspectable companion to the package. Each route pairs semantic HTML with explicit SEO metadata and a schema graph built by <code>astro-seo-complement</code>.</p>
  </section>
  <h2>Explore the supported use cases</h2>
  <div class="grid">
    {examples.map(([href, name, detail]) => <article class="card"><h3><a href={href}>{name}</a></h3><p>{detail}</p></article>)}
  </div>
  <h2>What to inspect</h2>
  <div class="grid">
    <article class="card"><h3>Metadata</h3><p>Canonical URLs, descriptions, Open Graph, Twitter cards, robots directives, and authors are generated by one reusable component.</p></article>
    <article class="card"><h3>JSON-LD</h3><p>Open each route's inspection panel, then compare the graph with the page source. The visible copy is intentionally aligned with the machine-readable data.</p></article>
  </div>
</DemoLayout>
