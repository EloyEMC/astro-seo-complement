---
import type { CollectionEntry } from 'astro:content';
import { absoluteUrl, resolveSeoMetadata, robotsValue, serializeJsonLd, type SeoMetadata } from '../seo';
import { buildBlogPosting, composeGraph, type SchemaInput, type SchemaGraph } from '../schemas';

interface SharedProps {
  siteUrl: string;
  defaultImage?: string;
  defaultLocale?: string;
  siteName?: string;
  favicon?: string;
  schema?: SchemaInput | SchemaGraph;
}

type BlogProps = SharedProps & { entry: CollectionEntry<'blog'> };
type ExplicitProps = SharedProps & SeoMetadata & { entry?: never };
type Props = BlogProps | ExplicitProps;

const props = Astro.props as Props;
const {
  siteUrl,
  defaultImage,
  defaultLocale = 'en_US',
  siteName,
  favicon,
  schema: providedSchema,
} = props;

const metadata: SeoMetadata = 'entry' in props && props.entry
  ? {
      ...props.entry.data,
      image: props.entry.data.image,
      imageAlt: props.entry.data.image_alt,
      twitterImage: props.entry.data.twitter_img,
    }
  : props;

const resolved = resolveSeoMetadata(
  metadata,
  siteUrl,
  Astro.url.pathname,
  defaultImage,
);
const {
  title,
  description,
  imageAlt,
  tags,
  keywords,
  twitterCreator,
  twitterSite,
  author,
  authorUrl,
  locale,
  ogType = 'article',
  noindex,
  nofollow,
} = resolved;
const robots = robotsValue(noindex, nofollow);
const generatedSchema = 'entry' in props && props.entry && author
  ? buildBlogPosting({
      headline: title,
      description,
      url: resolved.canonical,
      siteUrl,
      image: resolved.imageUrl,
      datePublished: metadata.date,
      dateModified: metadata.modifiedDate,
      author: {
        name: author,
        url: authorUrl,
        image: props.entry.data.authorImage,
        siteUrl,
      },
      publisher: siteName ? { name: siteName, siteUrl } : undefined,
      keywords,
    })
  : undefined;
const schemaGraph = providedSchema
  ? (('@graph' in providedSchema) ? providedSchema : composeGraph(providedSchema))
  : generatedSchema
    ? composeGraph(generatedSchema)
    : undefined;
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
{keywords?.length && <meta name="keywords" content={keywords.join(', ')} />}
{robots && <meta name="robots" content={robots} />}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={resolved.imageUrl} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={locale ?? defaultLocale} />
<meta property="og:url" content={resolved.canonical} />
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={resolved.twitterImageUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
<link rel="canonical" href={resolved.canonical} />
{author && <meta name="author" content={author} />}
{authorUrl && <link rel="author" href={absoluteUrl(authorUrl, siteUrl)} />}
{resolved.publishedDate && <meta property="article:published_time" content={resolved.publishedDate} />}
{metadata.modifiedDate && <meta property="article:modified_time" content={resolved.modified} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}
{schemaGraph && <script is:inline type="application/ld+json" set:html={serializeJsonLd(schemaGraph)} />}
{favicon && <link rel="icon" href={absoluteUrl(favicon, siteUrl)} />}
