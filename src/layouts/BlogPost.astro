---
import SEO from '../components/SEO.astro';
import AuthorBox from '../components/AuthorBox.astro';
import type { CollectionEntry } from 'astro:content';
import '../styles/editorial-demo.css';

interface Props {
  post: CollectionEntry<'blog'>;
  siteUrl: string;
  defaultImage?: string;
}

const { post, siteUrl, defaultImage } = Astro.props;
const routes = [
  ['/about/', 'About'], ['/editorial/', 'Editorial'],
  ['/reviews/', 'Reviews'], ['/faq/', 'FAQ'], ['/how-to/', 'How-to'], ['/video/', 'Video SEO'], ['/breadcrumbs/', 'Breadcrumbs'],
];
---
<!doctype html>
<html lang={post.data.locale?.split('_')[0] ?? 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon-emc.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-emc.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/favicon-emc.webp" />
    <SEO entry={post} siteUrl={siteUrl} defaultImage={defaultImage} siteName={post.data.siteName} />
  </head>
  <body class="demo-shell blog-layout">
    <aside class="demo-sidebar" aria-label="Site navigation">
      <div>
        <a class="demo-brand" href="/" aria-label="eloymartinezcuesta.com home">
          <img class="demo-brand-logo" src="/logo-emc.webp" alt="EMC logo" width="1200" height="800" />
          <span class="demo-brand-name">eloymartinezcuesta.com</span>
        </a>
        <p class="demo-kicker">Editorial notes</p>
        <nav class="demo-nav" aria-label="Demo routes">
          <ul>
            <li><a href="/">Home</a></li>
            {routes.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </nav>
      </div>
      <p class="demo-sidebar-footer">A real content entry<br />with a complete graph.</p>
    </aside>
    <div class="demo-main">
      <div class="demo-topbar"><a href="/">Back to the demo index ↗</a></div>
      <main class="demo-content">
        <article class="blog-article">
          <header class="blog-article-header">
            <p class="demo-eyebrow">Blog posting · {post.data.tags?.[0] ?? 'Editorial'}</p>
            <h1 class="blog-article-title">{post.data.title}</h1>
            <p class="blog-article-meta">{post.data.author} · {post.data.date.toISOString().slice(0, 10)}</p>
          </header>
          <div class="blog-prose"><slot /></div>
          {post.data.author && <AuthorBox author={post.data.author} authorUrl={post.data.authorUrl} authorImage={post.data.authorImage} date={post.data.date} />}
        </article>
      </main>
      <footer class="demo-footer"><strong>astro-seo-complement Demo</strong> · Visible content powered by <code>astro-seo-complement</code> and aligned with BlogPosting JSON-LD. <a href="/about/">About the project</a> · <a href="https://github.com/EloyEMC/astro-seo-complement">Source on GitHub</a></footer>
    </div>
  </body>
</html>
