---
import SEO from '../components/SEO.astro';
import SchemaInspector from '../components/SchemaInspector.astro';
import { siteConfig } from '../config';
import type { SchemaGraph } from '../schemas';
import '../styles/editorial-demo.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  schema?: SchemaGraph;
  ogType?: 'website' | 'article';
  keywords?: string[];
  eyebrow?: string;
  uppercaseTitle?: boolean;
}

const { title, description, canonicalUrl, schema, ogType = 'website', keywords, eyebrow, uppercaseTitle = false } = Astro.props;
const defaultImage = `${siteConfig.site}/og-default.svg`;
const routes = [
  ['/about/', 'About'], ['/blog/', 'Blog'], ['/editorial/', 'Editorial'],
  ['/product/', 'Product'], ['/reviews/', 'Reviews'], ['/faq/', 'FAQ'],
  ['/how-to/', 'How-to'], ['/video/', 'Video SEO'], ['/breadcrumbs/', 'Breadcrumbs'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon-emc.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-emc.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon-emc-16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-emc-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-emc-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon-emc-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-emc-v4.png" />
    <SEO
      siteUrl={siteConfig.site}
      siteName={siteConfig.title}
      defaultImage={defaultImage}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      keywords={keywords}
      ogType={ogType}
      schema={schema}
      locale={siteConfig.locale}
    />
  </head>
  <body class="demo-shell">
    <aside class="demo-sidebar" aria-label="Site navigation">
      <div>
            <a class="demo-brand" href="/" aria-label="astro-seo-complement Demo home">
              <img class="demo-brand-logo" src="/logo-emc.webp" alt="EMC logo" width="1200" height="800" />
              <span class="demo-brand-name">astro-seo-complement Demo</span>
            </a>
        <p class="demo-kicker">Inspectable by design</p>
        <nav class="demo-nav" aria-label="Demo routes">
          <ul>
            <li><a href="/">Home</a></li>
            {routes.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </nav>
      </div>
      <p class="demo-sidebar-footer">Semantic content.<br />Explicit metadata.<br />One composed graph.</p>
    </aside>
    <div class="demo-main">
      <div class="demo-topbar"><a href="https://github.com/EloyEMC/astro-seo-complement">Open-source SEO primitives ↗</a></div>
      <main class="demo-content">
        <header class="demo-hero">
          {eyebrow && <p class="demo-eyebrow">{eyebrow}</p>}
          <h1>{uppercaseTitle ? title.toUpperCase() : title}</h1>
          <p class="demo-lede">{description}</p>
        </header>
        <slot />
        {schema && <SchemaInspector schema={schema} />}
      </main>
      <footer class="demo-footer"><strong>astro-seo-complement Demo</strong> · A template powered by <code>astro-seo-complement</code> for comparing visible content, metadata, canonical URLs, and JSON-LD graphs. <a href="/about/">About the project</a> · <a href="https://github.com/EloyEMC/astro-seo-complement">Source on GitHub</a></footer>
    </div>
  </body>
</html>
